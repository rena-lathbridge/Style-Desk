# Copy this file to .env and fill in ONE of the two keys below.
# The app looks for .env in its own folder first, then one folder up.
# Never commit your real .env.

# Course key (Portkey). Used with the gpt-6-luna model.
PORTKEY_API_KEY=your-portkey-key-here

# Optional: your own OpenAI key. If set, this is used instead of Portkey.
# OPENAI_API_KEY=your-openai-key-here
